{
    "name": "ilc-sdk",
    "version": "0.0.0",
    "description": "SDK for app development with Isomorphic Layout Composer",
    "main": "dist/server/index.js",
    "types": "dist/server/index.d.ts",
    "files": [
        "dist/**",
        "app.js",
        "app.d.ts"
    ],
    "scripts": {
        "build": "tsc -p ./src/app && tsc -p ./src/server",
        "test": "mocha -r ts-node/register test/**/*.ts",
        "coverage": "nyc npm run test",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
        "lint": "eslint src",
        "docs": "typedoc",
        "preversion": "npm run format:check && npm run lint && npm test",
        "prepublish": "npm run build",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/namecheap/ilc-sdk.git"
    },
    "author": "Namecheap, Inc",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/namecheap/ilc-sdk/issues"
    },
    "homepage": "https://github.com/namecheap/ilc-sdk#readme",
    "devDependencies": {
        "@commitlint/cli": "^19.5.0",
        "@commitlint/config-conventional": "^19.5.0",
        "@eslint/js": "^10.0.1",
        "@knodes/typedoc-plugin-pages": "^0.23.4",
        "@types/chai": "^4.3.9",
        "@types/chai-as-promised": "^7.1.7",
        "@types/chai-snapshot-matcher": "^1.0.4",
        "@types/jsdom": "^21.1.7",
        "@types/memoizee": "^0.4.10",
        "@types/mocha": "^10.0.3",
        "@types/node": "^20.8.7",
        "@types/sinon": "^10.0.20",
        "chai": "^4.3.10",
        "chai-as-promised": "^7.1.1",
        "chai-snapshot-matcher": "^2.0.3",
        "eslint": "^10.12.0",
        "husky": "^9.1.6",
        "jsdom": "^29.1.1",
        "jsdom-global": "^3.0.2",
        "lint-staged": "^16.4.0",
        "mocha": "^12.0.3",
        "mock-http": "^1.1.0",
        "nock": "^13.3.6",
        "nyc": "^18.0.0",
        "prettier": "^3.0.3",
        "sinon": "^17.0.0",
        "ts-node": "^10.9.1",
        "typedoc": "~0.23.28",
        "typedoc-plugin-missing-exports": "^1.0.0",
        "typedoc-plugin-rename-defaults": "0.6.6",
        "typescript": "~5.0.4",
        "typescript-eslint": "^8.71.1"
    },
    "dependencies": {
        "@namecheap/webpack-inject-plugin": "^2.0.1",
        "@types/url-join": "^4.0.2",
        "avsc": "^5.7.9",
        "axios": "^1.20.0",
        "memoizee": "^0.4.15",
        "url-join": "^4.0.1"
    },
    "peerDependencies": {
        "webpack": "^5.0.0"
    },
    "overrides": {
        "conventional-changelog-conventionalcommits": ">= 8.0.0",
        "@istanbuljs/load-nyc-config": {
            "js-yaml": "^4.1.1"
        }
    },
    "engines": {
        "node": ">=20",
        "npm": ">=7"
    },
    "allowScripts": {
        "es5-ext": false
    }
}
